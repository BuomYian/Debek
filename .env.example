# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already covered by .gitignore.

# ── Supabase ────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, bypasses Row Level Security.
# Used by the seed script and trusted admin server actions ONLY.
# NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cloudinary ──────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
# Server-only. Signed uploads are generated in a server action — this
# secret must never reach the browser bundle.
CLOUDINARY_API_SECRET=your-api-secret

# Public cloud name, safe for the browser (used to build delivery URLs
# and unsigned widget config only — never for signing).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
